#!/bin/bash

case "$1" in
  pro) MODEL="Gemini 3.1 Pro (High)" ;;
  *) MODEL="Gemini 3.5 Flash (Low)" ;;
esac

DIFF=$(git diff --cached | head -c 100000)

if [ -z "$DIFF" ]; then
  echo "Staged changes not found."
  exit 1
fi

PROMPT="You are writing git commit messages. Below is the staged diff.
Generate 5 concise, descriptive commit messages that accurately reflect ONLY the
changes in this diff. Focus on 'what' and 'why'.
Output ONLY the messages, one per line, without numbering, headers, or markdown.
Do not use any tools; answer directly from the diff below.

--- BEGIN DIFF ---
$DIFF
--- END DIFF ---"

RESULT=$(agy --model "$MODEL" -p "$PROMPT" 2> /dev/null)

if [ -z "$RESULT" ]; then
  RESULT=$(agy --model "$MODEL" -p "$PROMPT" 2> /dev/null)
fi

if [ -z "$RESULT" ]; then
  echo "AI generation failed or returned empty. Please enter manually."
  exit 0
fi

echo "$RESULT"
