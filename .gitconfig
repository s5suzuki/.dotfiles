[include]
	path = ~/.config/delta/themes/catppuccin.gitconfig

[core]
    editor = nvim
    pager = delta

[interactive]
    diffFilter = delta --color-only

[init]
    defaultBranch = main

[delta]
    navigate = true
    dark = true
    side-by-side = true
    features = catppuccin-mocha

[merge]
    conflictStyle = zdiff3

[include]
	path = ~/.gitconfig.local
