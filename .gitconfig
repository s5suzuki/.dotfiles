[include]
	path = ~/.config/delta/themes/catppuccin.gitconfig

[core]
    editor = nvim
    pager = delta

[interactive]
    diffFilter = delta --color-only

[init]
    defaultBranch = main

[delta]
    navigate = true
    dark = true
    side-by-side = true
    features = catppuccin-mocha

[merge]
    conflictStyle = zdiff3

[credential "https://github.com"]
	helper =
	helper = !$HOME/.dotfiles/src/scripts/git-credential-gh-user
[credential "https://gist.github.com"]
	helper =
	helper = !$HOME/.dotfiles/src/scripts/git-credential-gh-user

#   [includeIf "hasconfig:remote.*.url:**/<owner>/**"]
#   	path = ~/.config/git/accounts/<account>.gitconfig
#   [includeIf "hasconfig:remote.*.url:**:<owner>/**"]
#   	path = ~/.config/git/accounts/<account>.gitconfig
#
#  	```~/.config/git/accounts/<account>.gitconfig
#  	[gh]
#  	    user = <account>
#  	```

[include]
	path = ~/.gitconfig.local
